{
  "name": "qavril-labs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QAVRIL LABS. backend/ (Claude Code) and frontend/ (Antigravity) are separate npm projects; these scripts only run them.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:all": "node scripts/dev-all.mjs",
    "typecheck": "npm --prefix backend run typecheck",
    "test": "npm --prefix backend test",
    "migrate": "npm --prefix backend run migrate",
    "catalog:generate": "npm --prefix backend run catalog:generate",
    "site:build": "npm --prefix frontend run site:build",
    "site:check": "npm --prefix frontend run site:check",
    "dev:web": "npm --prefix frontend run dev:web"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
