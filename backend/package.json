{
  "name": "qavril-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QAVRIL LABS backend: HTTP API, worker, domain packages and the agent service. Owned by Claude Code.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "npm run migrate -w @erp/db",
    "leads:export": "npm run leads:export -w @erp/db",
    "catalog:generate": "node scripts/generate-product-registry.mjs",
    "dev:api": "npm run dev -w @erp/api",
    "dev:worker": "npm run dev -w @erp/worker"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
