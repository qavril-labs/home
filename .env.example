# Copy to .env for local runs. Never commit .env. Values here are placeholders only.

# --- Core database (Neon project "qavril-saas", database "core") ---
# Owner role: migrations only.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/erp_dev
# App role without superuser or BYPASSRLS: the API and worker use this, so row-level security applies.
APP_DATABASE_URL=

# --- Product databases (one Neon project per product family, see docs/infrastructure.md) ---
# AGENTS_DATABASE_URL=     # services/uaap (Neon project "qavril-agents")
# PACK_DS_DATABASE_URL=    # an industry pack, e.g. distribution and FMCG, once it is built

# --- Redis for BullMQ queues ---
REDIS_URL=redis://127.0.0.1:6379
OUTBOX_RELAY_MS=1000

# --- API ---
PORT=3002
HOST=127.0.0.1
PLATFORM_ADMIN_KEY=change-me-to-32-or-more-random-characters
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=false
LEAD_WEBHOOK_URL=
