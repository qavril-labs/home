{
  "$description": "QAVRIL LABS design tokens. The single source of colours, type, spacing, borders and chart colours for every surface: the marketing site and the web app, whether Claude Code or Antigravity builds it. Antigravity owns this file; Claude Code reviews contrast. Change a value here, then copy it to tokens.css and tailwind.preset.cjs in the same commit.",
  "color": {
    "light": {
      "page": "#f7f6ff",
      "panel": "#ffffff",
      "cream": "#fff4dc",
      "ink": "#0a0a0f",
      "text": "#15122b",
      "muted": "#4a4568",
      "grid": "rgba(10, 10, 15, 0.10)"
    },
    "dark": {
      "page": "#0d0b1f",
      "panel": "#16122e",
      "cream": "#fff4dc",
      "ink": "#0a0a0f",
      "text": "#f7f5ff",
      "muted": "#d4cfee",
      "grid": "rgba(255, 255, 255, 0.14)"
    },
    "accent": {
      "lime": "#c6ff3d",
      "pink": "#ff4fa3",
      "violet": "#8b6bff",
      "cyan": "#3de8ff",
      "yellow": "#ffe14d",
      "orange": "#ff8a3d"
    },
    "status": {
      "$note": "Always shown with an icon and a word, never colour alone.",
      "good": { "light": "#1a7f37", "dark": "#6fdd8b", "icon": "✓", "label": "All good" },
      "watch": { "light": "#9a6700", "dark": "#f2c94c", "icon": "!", "label": "Worth a look" },
      "act": { "light": "#b42318", "dark": "#ff8b80", "icon": "●", "label": "Needs you" },
      "idle": { "light": "#4a4568", "dark": "#c9c3ea", "icon": "…", "label": "Waiting for data" }
    },
    "chart": {
      "$note": "Validated for colour-blind readers in both themes. Money in = violet, money out = orange. Add series only after re-running the dataviz palette validator.",
      "series1": { "name": "money in (sales, revenue)", "light": "#6250d6", "dark": "#9085e9" },
      "series2": { "name": "money out (expenses, costs)", "light": "#eb6834", "dark": "#d95926" },
      "cash": "#c6ff3d"
    },
    "bot": {
      "$note": "Each bot keeps one colour on every surface.",
      "ledger-lou": "#3de8ff",
      "chase-chloe": "#ffe14d",
      "forecast-finn": "#8b6bff",
      "guard-gus": "#ff4fa3",
      "pip": "#c6ff3d",
      "restock-rex": "#ff8a3d",
      "ticket-tess": "#3de8ff",
      "onboard-ola": "#c6ff3d"
    }
  },
  "font": {
    "display": "\"Unbounded\", \"Arial Black\", system-ui, sans-serif",
    "body": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Unbounded:wght@800&display=swap",
    "size": { "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.15rem", "xl": "1.5rem", "display": "clamp(1.8rem, 3.6vw, 2.8rem)" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px" },
  "border": { "line": "3px solid #0a0a0f", "thin": "2px solid #0a0a0f", "radius": { "button": "14px", "card": "0px", "pill": "999px" } },
  "shadow": { "card": "8px 8px 0 #0a0a0f", "small": "4px 4px 0 #0a0a0f", "hover": "11px 11px 0 #0a0a0f" },
  "layout": { "maxWidth": "1240px", "gutter": "16px", "columns": 12, "gap": "16px", "breakpoints": { "phone": "520px", "tablet": "960px", "desktop": "1100px" } },
  "motion": { "fast": "180ms", "base": "300ms", "countUp": "900ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)", "reducedMotion": "Turn every animation off when prefers-reduced-motion is set." }
}
